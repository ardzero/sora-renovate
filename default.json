{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Base settings shared by every repo Sora updates. Extend with \"github>ardzero/sora-renovate\".",
  "extends": [
    "config:recommended",
    ":configMigration",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "timezone": "Etc/UTC",
  "labels": ["dependencies"],
  "rangeStrategy": "bump",
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "platformAutomerge": false,
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": ["dependencies", "security"]
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "packageRules": [
    {
      "description": "engines.node is the minimum Node.js users need, a deliberate support decision; don't raise it on every Node release",
      "matchDepTypes": ["engines"],
      "enabled": false
    }
  ]
}

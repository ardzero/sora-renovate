{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Weekly batch policy: one grouped non-major PR on Monday mornings, majors separate. Extend with \"github>ardzero/sora-renovate:weekly\".",
  "extends": ["github>ardzero/sora-renovate"],
  "schedule": ["before 6am on monday"],
  "lockFileMaintenance": {
    "schedule": ["before 6am on monday"]
  },
  "packageRules": [
    {
      "description": "Batch all non-major npm updates into one weekly PR and automerge it once CI passes",
      "matchManagers": ["bun", "npm"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "non-major dependencies",
      "groupSlug": "non-major",
      "automerge": true
    },
    {
      "description": "0.x minor updates can break (semver): their own PR, reviewed by hand",
      "matchManagers": ["bun", "npm"],
      "matchUpdateTypes": ["minor"],
      "matchCurrentVersion": "<1.0.0",
      "groupName": "pre-1.0 minor updates",
      "groupSlug": "pre-1-minor",
      "automerge": false
    },
    {
      "description": "Major npm updates always need manual review",
      "matchManagers": ["bun", "npm"],
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "addLabels": ["major"]
    },
    {
      "description": "Batch GitHub Actions and workflow Node.js updates into one PR; majors get their own PR for review",
      "matchManagers": ["github-actions", "custom.regex"],
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions"
    },
    {
      "matchManagers": ["github-actions", "custom.regex"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    }
  ]
}
